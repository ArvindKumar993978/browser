{
  "name": "orbit-browser",
  "version": "0.1.5",
  "description": "Orbit Browser - Custom multi-tab Electron WebContentsView browser",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
